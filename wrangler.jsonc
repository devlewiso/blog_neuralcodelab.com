// Sitio servido por Cloudflare Workers como assets estáticos (migrado desde Netlify).
// Deploy: npx wrangler deploy (corre el build antes de subir)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-neuralcodelab",
  "compatibility_date": "2026-09-01",
  "build": { "command": "npx -y pnpm@9 run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "blog.neuralcodelab.com", "custom_domain": true }
  ]
}
